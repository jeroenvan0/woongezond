[Unit]
Description=Woongezond periodic sensor reports — every morning; each contact's frequency decides

[Timer]
# Every day 08:00 Amsterdam time (the VPS clock is UTC, hence the explicit zone). The route
# sends daily contacts every day, weekly ones on Monday, monthly ones on the 1st.
# (:02/:17/:32/:47) and the hourly weather ingest (:05).
OnCalendar=*-*-* 08:00:00 Europe/Amsterdam
# Persistent so a reboot doesn't skip a morning.
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
